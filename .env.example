# Required provider credentials. Keep the real values only in .env locally or
# in your deployment platform's encrypted secret store.
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Future Next.js client, comma-separated. Leave empty to disable browser CORS.
ALLOWED_ORIGINS=http://localhost:3000
# Public API hostnames, comma-separated. Configure this before production.
TRUSTED_HOSTS=localhost,127.0.0.1

# Production safeguards
MAX_REQUEST_BODY_BYTES=16384
MAX_CONCURRENT_REQUESTS=20
LOG_LEVEL=INFO
LLM_ENABLED=true
EXPLAIN_DAILY_LLM_BUDGET=25
